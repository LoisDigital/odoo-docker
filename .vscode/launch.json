{
    // This configuration is meant to be used inside the odoo-service
    // container created by the docker-compose-dev.yml file.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run Odoo",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/odoo/odoo-bin",
            "args": [
                "--database=development",
                // "--init=customize",
                "--dev=xml,qweb",
                "--config=/etc/odoo/odoo.conf",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🧪 Run tests",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/odoo/odoo-bin",
            "args": [
                "--database=development",
                "--dev=xml,qweb",
                "--config=/etc/odoo/odoo.conf",
                "--test-tags=${input:testTags}",
                // "--screencasts=/tmp",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🔄 Update module",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/odoo/odoo-bin",
            "args": [
                "--database=development",
                "--dev=xml,qweb",
                "--config=/etc/odoo/odoo.conf",
                "--update=${input:module}",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "📦 Install module",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/odoo/odoo-bin",
            "args": [
                "--database=development",
                "--dev=xml,qweb",
                "--config=/etc/odoo/odoo.conf",
                "--init=${input:module}",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🗄️ Init DB",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/odoo/odoo-bin",
            "args": [
                "--dev=xml,qweb",
                "--config=/etc/odoo/odoo.conf",
                //"--load-language=fr_FR",
                "--init=${input:initModule}",
                "--database=development",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🏗️ Scaffold",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "program": "${workspaceRoot}/odoo/odoo-bin",
            "args": [
                "scaffold",
                "${input:scaffoldModule}",
                "${input:scaffoldPath}"
            ],
            "console": "integratedTerminal"
        },
    ],
    "inputs": [
        {
            "id": "module",
            "description": "Module name",
            "default": "panda_lingua",
            "type": "promptString"
        },
        {
            "id": "testTags",
            "description": "Test tags (e.g., /module_name, TestClass.test_method, /module1,/module2)",
            "default": "/panda_lingua",
            "type": "promptString"
        },
        {
            "id": "initModule",
            "description": "Module to initialize with database",
            "default": "customize",
            "type": "promptString"
        },
        {
            "id": "scaffoldModule",
            "description": "New module name to scaffold",
            "default": "module_name",
            "type": "promptString"
        },
        {
            "id": "scaffoldPath",
            "description": "Path where to create the scaffolded module",
            "default": "/opt/odoo/custom_addons/loistalagrand",
            "type": "promptString"
        }
    ]
}